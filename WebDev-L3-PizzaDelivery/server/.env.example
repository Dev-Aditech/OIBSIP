# Copy this file to ".env" in the same folder (server/) and fill in your own values.
# NEVER commit ".env". Only this example file belongs in Git.

# ---------------------------------------------------------------
# Database (MongoDB Atlas)
# ---------------------------------------------------------------
# Keep the database name (pizzaapp) before the "?". Avoid @ : / # in the password.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/pizzaapp?retryWrites=true&w=majority

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=5000

# Long random text used to sign login tokens. Create one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-text

# Where the React app runs. Links in emails are built from this, so it must match
# the address Vite prints when you run "npm run dev" in the client folder.
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------
# Admin account (created by "npm run seed")
# ---------------------------------------------------------------
ADMIN_NAME=Pizza Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# ---------------------------------------------------------------
# Razorpay (optional, TEST keys only, they start with rzp_test_)
# Leave both empty to use the built-in mock payment instead.
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------
# Email (optional)
# Leave EMAIL_HOST empty to use Ethereal, a fake inbox for development:
# emails are not delivered, the server terminal prints an "Email preview:" link instead.
# For Gmail: host smtp.gmail.com, port 587, and an app password (needs 2-Step Verification).
# ---------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="SliceCraft <you@example.com>"

# ---------------------------------------------------------------
# Low-stock check (optional)
# How often to look for ingredients below their threshold, as a cron expression.
# Default is every minute. Example for once an hour: 0 * * * *
# ---------------------------------------------------------------
LOW_STOCK_CRON="* * * * *"
